# Oracle connection used by the marimo direct-logon demo.
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1
ORACLE_PROTOCOL=tcp
ORACLE_WALLET_LOCATION=

# Driver mode. Use thick when the database requires Native Network Encryption
# or network checksumming. Thick mode requires Oracle Client libraries.
ORACLE_DRIVER_MODE=thin
ORACLE_CLIENT_LIB_DIR=
ORACLE_CLIENT_CONFIG_DIR=

# Admin connection used only by scripts/run_sql.py.
ORACLE_ADMIN_USER=sys
ORACLE_ADMIN_PASSWORD=change_me
ORACLE_ADMIN_MODE=sysdba

# Demo namespace and shared local-demo password.
# Replace this value before using any shared or persistent database.
DEMO_SCHEMA=DEMO_HR
DEMO_DEFAULT_PASSWORD=change_me
DEMO_CONNECT_TIMEOUT=5
DEMO_MODE=live

# Phase 2 Identity Domain / application-mediated demo.
# Values in this section are placeholders. Do not commit real secrets, tokens,
# private keys, or wallet material.

# Identity Domain and target database application registration.
IDENTITY_DOMAIN_URL=https://idcs-example.identity.oraclecloud.com:443
IDENTITY_DOMAIN_DATABASE_APP_ID=replace_with_database_application_id
IDENTITY_DOMAIN_DATABASE_AUDIENCE=replace_with_database_primary_audience
IDENTITY_DOMAIN_DATABASE_SCOPE_NAME=replace_with_database_access_scope_name
IDENTITY_DOMAIN_DATABASE_SCOPE=replace_with_full_database_scope
IDENTITY_DOMAIN_DATABASE_CLIENT_ID=replace_with_database_oauth_client_id
IDENTITY_DOMAIN_DATABASE_CLIENT_SECRET=change_me

# Demo application registration that uses OAuth client credentials.
DEMO_APP_ID=replace_with_demo_application_id
DEMO_APP_CLIENT_ID=replace_with_demo_oauth_client_id
DEMO_APP_CLIENT_SECRET=change_me
DEMO_APP_GRANT_TYPES=client_credentials
DEMO_APP_DATABASE_SCOPE=replace_with_full_database_scope
# Optional override. Defaults to ${IDENTITY_DOMAIN_URL}/oauth2/v1/token.
DEMO_APP_TOKEN_URL=

# Database-side DDS application identity and application-scoped Data Roles.
PHASE2_APP_IDENTITY=DEEPSEC_DEMO_APP
PHASE2_APP_DIRECTORY_DATA_ROLE=APP_DIRECTORY_LOOKUP_ROLE
PHASE2_APP_SENSITIVE_DATA_ROLE=APP_SENSITIVE_LOOKUP_ROLE
PHASE2_END_USER_MODEL=application_only

# Phase 2 runtime settings.
# client_credentials and DDS context attach require TCPS. Set ORACLE_PROTOCOL=tcps
# above and use the target database TCPS listener/port and wallet settings.
# client_credentials uses DEMO_APP_* to request an access token and passes it
# to python-oracledb as the database logon token. The target DB must already
# map that OAuth client to the shared DB user.
APP_DB_AUTH_MODE=client_credentials
APP_DB_USERNAME=DEEPSEC_APP
APP_DB_PASSWORD=
APP_SECURITY_CONTEXT_MODE=identity_domain_client_credentials
APP_END_USER_CONTEXT_KEY=change_me
APP_DATA_ROLES=APP_DIRECTORY_LOOKUP_ROLE,APP_SENSITIVE_LOOKUP_ROLE
APP_CONTEXT_ATTRIBUTES_JSON={}
APP_TOKEN_REQUEST_TIMEOUT=10

# Optional DB global user mapping descriptor for sql/07_create_shared_app_user.sql.
# APP_IAM_MAPPING is used only when that optional SQL file is rendered.
APP_IAM_MAPPING=IAM_PRINCIPAL_OCID=ocid1.instance.region1..replace_with_app_principal_ocid
